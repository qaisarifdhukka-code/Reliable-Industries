---
import { Clock, Mail, MapPin, MessageSquare, Phone } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import UtilityBar from '@/components/UtilityBar.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHeader from '@/components/PageHeader.astro';
import ContactInquiryForm from '@/components/ContactInquiryForm';
import { SITE_CONFIG } from '@/config/site';
import { CONTACT_DEPARTMENTS } from '@/data/companyData';

const deptAccentClasses: Record<'cyan' | 'yellow' | 'navy', string> = {
  cyan: 'border-t-[#009FE3]',
  yellow: 'border-t-[#FFE600]',
  navy: 'border-t-[#003B6D]',
};
---

<BaseLayout
  title={`Contact Our Experts | ${SITE_CONFIG.brandName}`}
  description="Whether you need a custom quote, technical support, or application engineering guidance, contact Reliable Industries headquarters in Mumbai."
>
  <UtilityBar />
  <Header />
  <main id="main-content">
    <PageHeader
      kicker="GET IN TOUCH"
      title="Contact Our Experts"
      subtitle="Whether you need a custom quote, technical support, or have a general inquiry, our team of sealing experts is ready to assist you."
      breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
      align="center"
    />

    <!-- Contact Split Section -->
    <section class="bg-[#F4F6F8] py-[3.5rem] min-[769px]:py-[5rem]">
      <div class="site-container grid grid-cols-1 gap-[2.5rem] min-[961px]:grid-cols-[1fr_1.15fr] min-[961px]:items-start min-[1201px]:gap-[3.5rem]">
        <!-- Left Info Panel -->
        <div>
          <h2 class="mb-[1rem] text-[1.75rem] font-bold leading-[1.2] text-[#003B6D] min-[769px]:text-[2.2rem]">
            Let&apos;s build something <span class="text-[#009FE3]">Reliable</span> together.
          </h2>
          <p class="mb-[2rem] text-[1rem] leading-[1.6] text-[#334155]">
            Reach out to our global headquarters or fill out the form, and a representative will get back to you within 24 hours.
          </p>

          <div class="space-y-[1.25rem]">
            <div class="flex items-start gap-[1rem] rounded-[2px] border border-[#e2e8f0] bg-white p-[1.25rem]">
              <div class="flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-full bg-[#009FE3] text-white">
                <MapPin size={19} stroke-width={2} aria-hidden="true" />
              </div>
              <div>
                <h3 class="mb-[0.25rem] text-[1rem] font-bold text-[#003B6D]">
                  Headquarters
                </h3>
                <p class="text-[0.92rem] leading-[1.55] text-[#334155]">
                  {
                    SITE_CONFIG.businessDetails.addressLines.map((line, idx) => (
                      <>
                        {line}
                        {idx < SITE_CONFIG.businessDetails.addressLines.length - 1 && (
                          <br />
                        )}
                      </>
                    ))
                  }
                </p>
              </div>
            </div>

            <div class="flex items-start gap-[1rem] rounded-[2px] border border-[#e2e8f0] bg-white p-[1.25rem]">
              <div class="flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-full bg-[#009FE3] text-white">
                <Mail size={19} stroke-width={2} aria-hidden="true" />
              </div>
              <div>
                <h3 class="mb-[0.25rem] text-[1rem] font-bold text-[#003B6D]">
                  Email Us
                </h3>
                <a
                  href={`mailto:${SITE_CONFIG.businessDetails.email}`}
                  class="text-[0.95rem] font-semibold text-[#009FE3] transition-colors hover:text-[#003B6D]"
                >
                  {SITE_CONFIG.businessDetails.email}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-[1rem] rounded-[2px] border border-[#e2e8f0] bg-white p-[1.25rem]">
              <div class="flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-full bg-[#009FE3] text-white">
                <Phone size={19} stroke-width={2} aria-hidden="true" />
              </div>
              <div>
                <h3 class="mb-[0.25rem] text-[1rem] font-bold text-[#003B6D]">
                  Call Us
                </h3>
                <div class="flex flex-col gap-[3px] text-[0.92rem] text-[#334155]">
                  {
                    SITE_CONFIG.businessDetails.phones.map((phone) => (
                      <a
                        href={`tel:${phone.replace(/[^+\d]/g, '')}`}
                        class="font-medium transition-colors hover:text-[#009FE3]"
                      >
                        {phone}
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>

            <div class="flex items-start gap-[1rem] rounded-[2px] border border-[#e2e8f0] bg-white p-[1.25rem]">
              <div class="flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-full bg-[#003B6D] text-white">
                <Clock size={19} stroke-width={2} aria-hidden="true" />
              </div>
              <div>
                <h3 class="mb-[0.25rem] text-[1rem] font-bold text-[#003B6D]">
                  Business &amp; Plant Hours
                </h3>
                <p class="text-[0.92rem] leading-[1.55] text-[#334155]">
                  {SITE_CONFIG.businessDetails.hours}
                  <br />
                  <strong class="text-[#009FE3]">
                    {SITE_CONFIG.businessDetails.emergencyLineLabel}
                  </strong>
                </p>
              </div>
            </div>
          </div>

          <div class="mt-[1.5rem] flex flex-wrap gap-[0.85rem]">
            <a
              href={SITE_CONFIG.businessDetails.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] items-center gap-[8px] rounded-[4px] border-2 border-[#009FE3] bg-[#009FE3] px-[1.35rem] py-[0.65rem] text-[0.92rem] font-semibold text-white transition-colors duration-300 hover:border-[#007BB5] hover:bg-[#007BB5]"
            >
              <MessageSquare size={17} stroke-width={2} aria-hidden="true" />
              <span>WhatsApp Instant</span>
            </a>
            <a
              href={`tel:${SITE_CONFIG.businessDetails.phones[0].replace(/[^+\d]/g, '')}`}
              class="inline-flex min-h-[44px] items-center gap-[8px] rounded-[4px] border-2 border-[#003B6D] bg-[#003B6D] px-[1.35rem] py-[0.65rem] text-[0.92rem] font-semibold text-white transition-colors duration-300 hover:border-[#002038] hover:bg-[#002038]"
            >
              <Phone size={17} stroke-width={2} aria-hidden="true" />
              <span>Direct Hotline</span>
            </a>
          </div>
        </div>

        <!-- Right Interactive Form -->
        <ContactInquiryForm
          client:visible
          recipientEmail={SITE_CONFIG.businessDetails.email}
          whatsappBaseUrl="https://wa.me/917888065557?"
        />
      </div>
    </section>

    <!-- Specialized Departments -->
    <section class="border-t border-[#e2e8f0] bg-white py-[3.5rem] min-[769px]:py-[5rem]">
      <div class="site-container">
        <div class="mb-[2.5rem] max-w-[720px]">
          <span class="mb-[0.5rem] block text-[0.85rem] font-bold uppercase tracking-[1.5px] text-[#009FE3]">
            DIRECT SUPPORT
          </span>
          <h2 class="mb-[0.75rem] text-[1.75rem] font-bold leading-[1.2] text-[#003B6D] min-[769px]:text-[2.2rem]">
            Specialized Department Contacts
          </h2>
          <p class="text-[0.98rem] text-[#334155]">
            Connect directly with the relevant division for instant assistance and prompt resolution.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-[1.5rem] min-[577px]:grid-cols-2 min-[1025px]:grid-cols-4">
          {
            CONTACT_DEPARTMENTS.map((dept) => (
              <article
                class:list={[
                  'flex flex-col rounded-[2px] border border-[#e2e8f0] border-t-4 bg-[#F4F6F8] p-[1.5rem]',
                  deptAccentClasses[dept.accent],
                ]}
              >
                <h3 class="mb-[0.65rem] text-[1.1rem] font-bold text-[#003B6D]">
                  {dept.title}
                </h3>
                <p class="mb-[1.25rem] grow text-[0.9rem] leading-[1.55] text-[#334155]">
                  {dept.description}
                </p>
                <div class="space-y-[0.45rem] border-t border-[#e2e8f0] pt-[0.9rem] text-[0.86rem] font-semibold text-[#003B6D]">
                  <a
                    href={`mailto:${dept.email}`}
                    class="flex items-center gap-[8px] break-all transition-colors hover:text-[#009FE3]"
                  >
                    <Mail size={14} stroke-width={2} class="shrink-0 text-[#009FE3]" aria-hidden="true" />
                    <span>{dept.email}</span>
                  </a>
                  <a
                    href={`tel:${dept.phone.replace(/[^+\d]/g, '')}`}
                    class="flex items-center gap-[8px] transition-colors hover:text-[#009FE3]"
                  >
                    <Phone size={14} stroke-width={2} class="shrink-0 text-[#009FE3]" aria-hidden="true" />
                    <span>{dept.phone}</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Location Map -->
    <section id="location" class="border-t border-[#e2e8f0] bg-[#F4F6F8]">
      <div class="h-[340px] w-full min-[769px]:h-[380px]">
        <iframe
          title="Reliable Industries Headquarters Map"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3768.857640698188!2d72.84277637599026!3d19.157672249419163!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be7b7ccb2db3c4b%3A0x6b5a34e565ea7e74!2sSaraf%20Kaskar%20Industrial%20Estate!5e0!3m2!1sen!2sin!4v1710000000000!5m2!1sen!2sin"
          class="h-full w-full border-0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
