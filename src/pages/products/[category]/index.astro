---
import { Image } from 'astro:assets';
import { ArrowRight, FileDown } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import UtilityBar from '@/components/UtilityBar.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHeader from '@/components/PageHeader.astro';
import { SITE_CONFIG } from '@/config/site';
import {
  CATALOG_PRODUCTS,
  getPrimaryImageMeta,
  SUBCATEGORY_GROUPS,
  type CatalogProduct,
  type SubCategoryGroupDef,
} from '@/data/catalog';

export function getStaticPaths() {
  const seenSlugs = new Set<string>();
  const paths: Array<{
    params: { category: string };
    props: { group: SubCategoryGroupDef; products: CatalogProduct[] };
  }> = [];

  for (const group of SUBCATEGORY_GROUPS) {
    seenSlugs.add(group.slug);
    paths.push({
      params: { category: group.slug },
      props: {
        group,
        products: CATALOG_PRODUCTS.filter((p) => group.match(p)),
      },
    });
  }

  for (const prod of CATALOG_PRODUCTS) {
    if (!seenSlugs.has(prod.categorySlug)) {
      seenSlugs.add(prod.categorySlug);
      paths.push({
        params: { category: prod.categorySlug },
        props: {
          group: {
            title: prod.category,
            slug: prod.categorySlug,
            superCategory: 'Products',
            match: (p) => p.categorySlug === prod.categorySlug,
          },
          products: CATALOG_PRODUCTS.filter(
            (p) => p.categorySlug === prod.categorySlug
          ),
        },
      });
    }
  }

  return paths;
}

interface Props {
  group: SubCategoryGroupDef;
  products: CatalogProduct[];
}

const { group, products } = Astro.props;
---

<BaseLayout
  title={`${group.title} | ${SITE_CONFIG.brandName}`}
  description={`Explore Reliable Industries ${group.title} mechanical sealing series with technical specifications and engineering data.`}
>
  <UtilityBar />
  <Header />
  <main id="main-content">
    <PageHeader
      kicker={group.superCategory}
      title={group.title}
      subtitle={`Browse technical specifications, operating limits, and engineering configurations for our ${group.title} series.`}
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Products', href: '/products' },
        { label: group.title },
      ]}
    />

    <section class="bg-[#F4F6F8] py-[3rem] min-[769px]:py-[4.5rem]">
      <div class="site-container">
        <div class="mb-[2rem] flex flex-wrap items-center justify-between gap-[1rem]">
          <p class="text-[0.95rem] font-semibold text-[#334155]">
            Showing <strong class="text-[#003B6D]">{products.length}</strong>{' '}
            {products.length === 1 ? 'model' : 'models'} in {group.title}
          </p>
          <a
            href={SITE_CONFIG.brochurePath}
            download={SITE_CONFIG.brochureDownloadName}
            class="inline-flex items-center gap-[8px] rounded-[4px] border-2 border-[#003B6D] bg-[#003B6D] px-[1.25rem] py-[0.55rem] text-[0.88rem] font-semibold text-white transition-colors hover:border-[#009FE3] hover:bg-[#009FE3]"
          >
            <FileDown size={15} stroke-width={2} aria-hidden="true" />
            <span>Download Full Catalogue (PDF)</span>
          </a>
        </div>

        <div class="grid grid-cols-1 gap-[1.5rem] min-[577px]:grid-cols-2 min-[1025px]:grid-cols-3">
          {
            products.map((prod) => {
              const primaryImg = getPrimaryImageMeta(prod);
              return (
                <article class="flex flex-col overflow-hidden rounded-[2px] border border-[#e2e8f0] bg-white shadow-[0_4px_20px_rgba(0,43,73,0.05)] transition-[transform,box-shadow] duration-300 ease-in-out hover:-translate-y-[4px] hover:shadow-[0_12px_28px_rgba(0,43,73,0.1)]">
                  <div class="aspect-[4/3] w-full overflow-hidden border-b border-[#F4F6F8] bg-white">
                    <Image
                      src={primaryImg}
                      alt={prod.name}
                      width={560}
                      format="webp"
                      quality={85}
                      class="h-full w-full object-contain mix-blend-multiply"
                    />
                  </div>

                  <div class="flex grow flex-col p-[1.25rem]">
                    <span class="mb-[0.35rem] block text-[0.72rem] font-bold uppercase tracking-[1px] text-[#009FE3]">
                      {prod.category}
                    </span>
                    <h2 class="mb-[0.65rem] text-[1.1rem] font-bold leading-[1.3] text-[#003B6D]">
                      <a
                        href={`/products/${prod.categorySlug}/${prod.slug}`}
                        class="transition-colors hover:text-[#009FE3]"
                      >
                        {prod.shortName}
                      </a>
                    </h2>
                    <p class="mb-[1rem] grow text-[0.9rem] leading-[1.55] text-[#475569]">
                      {prod.description}
                    </p>

                    {prod.badgeSpecs.length > 0 && (
                      <div class="mb-[1rem] flex flex-wrap gap-[0.45rem]">
                        {prod.badgeSpecs.map((spec) => (
                          <span class="rounded-[2px] border border-[#e2e8f0] bg-[#F4F6F8] px-[0.55rem] py-[0.25rem] text-[0.76rem] text-[#334155]">
                            <strong class="text-[#003B6D]">{spec.label}:</strong>{' '}
                            {spec.value}
                          </span>
                        ))}
                      </div>
                    )}

                    <div class="mt-auto flex items-center justify-between border-t border-[#e2e8f0] pt-[0.9rem]">
                      <a
                        href={`/products/${prod.categorySlug}/${prod.slug}`}
                        class="inline-flex items-center gap-[5px] text-[0.88rem] font-bold uppercase tracking-[0.5px] text-[#009FE3] transition-colors hover:text-[#003B6D]"
                      >
                        <span>View Specs</span>
                        <ArrowRight size={14} stroke-width={2.5} aria-hidden="true" />
                      </a>
                      <a
                        href={`/contact?inquiry=${encodeURIComponent(prod.name)}`}
                        class="text-[0.84rem] font-semibold text-[#64748b] transition-colors hover:text-[#003B6D]"
                      >
                        Request Quote
                      </a>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
