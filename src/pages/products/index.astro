---
import { Image } from 'astro:assets';
import { ArrowRight, FileDown } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import UtilityBar from '@/components/UtilityBar.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHeader from '@/components/PageHeader.astro';
import { SITE_CONFIG } from '@/config/site';
import {
  CATALOG_PRODUCTS,
  getPrimaryImageMeta,
  SUBCATEGORY_GROUPS,
} from '@/data/catalog';
import { PRODUCT_SUPER_CATEGORIES } from '@/data/navigation';

const superOrder = ['Mechanical Seal', 'Rotary Joints', 'Seal Support System'];
const customSuperGroups = PRODUCT_SUPER_CATEGORIES.filter(
  (g) => g.id === 'bearing-isolators' || g.id === 'spares'
);
---

<BaseLayout
  title={`Products & Sealing Solutions | ${SITE_CONFIG.brandName}`}
  description="Browse Reliable Industries mechanical seals, rotary pressure joints, thermosyphon seal support systems, bearing isolators, and lapped spares."
>
  <UtilityBar />
  <Header />
  <main id="main-content">
    <PageHeader
      kicker="OUR PORTFOLIO"
      title="Products & Sealing Solutions"
      subtitle="High-performance mechanical seals, monoflow & duoflow rotary unions, seal support vessels, and engineered components for demanding industrial process systems."
      breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Products' }]}
      align="center"
    />

    {
      superOrder.map((superTitle, groupIdx) => {
        const groups = SUBCATEGORY_GROUPS.filter(
          (g) => g.superCategory === superTitle
        );
        const isGreyBg = groupIdx % 2 === 0;
        return (
          <section
            class:list={[
              'py-[3rem] min-[769px]:py-[4.5rem]',
              isGreyBg ? 'bg-[#F4F6F8]' : 'bg-white',
            ]}
          >
            <div class="site-container">
              <div class="mb-[2rem] flex flex-col items-start justify-between gap-[1rem] min-[577px]:flex-row min-[577px]:items-end">
                <div>
                  <span class="mb-[0.4rem] block text-[0.82rem] font-bold uppercase tracking-[1.5px] text-[#009FE3]">
                    PRODUCT GROUP
                  </span>
                  <h2 class="text-[1.65rem] font-bold leading-[1.2] text-[#003B6D] min-[769px]:text-[2rem]">
                    {superTitle}
                  </h2>
                </div>
                <a
                  href={SITE_CONFIG.brochurePath}
                  download={SITE_CONFIG.brochureDownloadName}
                  class="inline-flex shrink-0 items-center gap-[7px] rounded-none border border-[#003B6D] bg-transparent px-[1.25rem] py-[0.55rem] text-[0.86rem] font-semibold text-[#003B6D] transition-colors duration-200 hover:bg-[#003B6D] hover:text-white"
                >
                  <FileDown size={15} stroke-width={2} aria-hidden="true" />
                  <span>Technical Catalogue</span>
                </a>
              </div>

              <div class="grid grid-cols-1 gap-[1.25rem] min-[577px]:grid-cols-2 min-[577px]:gap-[1.5rem] min-[1025px]:grid-cols-4">
                {groups.map((cat) => {
                  const products = CATALOG_PRODUCTS.filter((p) =>
                    cat.match(p)
                  );
                  const coverProd = products[0];
                  if (!coverProd) return null;
                  const coverImage = getPrimaryImageMeta(coverProd);
                  const targetHref =
                    products.length === 1
                      ? `/products/${coverProd.categorySlug}/${coverProd.slug}`
                      : `/products/${cat.slug}`;

                  return (
                    <article class="flex flex-col items-center rounded-[2px] border border-[#dce4ec] bg-white p-[1.25rem] pb-[1.5rem] text-center shadow-[0_4px_20px_rgba(0,43,73,0.06)] transition-[transform,box-shadow] duration-300 ease-in-out hover:-translate-y-[4px] hover:shadow-[0_12px_28px_rgba(0,43,73,0.1)]">
                      <div class="aspect-[4/3] w-full overflow-hidden rounded-[2px] border border-[#e6ebf1] bg-[#F4F6F8]">
                        <Image
                          src={coverImage}
                          alt={cat.title}
                          width={520}
                          format="webp"
                          quality={85}
                          class="block h-full w-full object-cover object-center"
                        />
                      </div>

                      <h3 class="mt-[1.15rem] text-[0.95rem] font-bold uppercase leading-[1.3] tracking-[0.3px] text-[#003B6D]">
                        {cat.title}
                      </h3>
                      <p class="mt-[0.3rem] text-[0.85rem] text-[#64748b]">
                        {products.length} {products.length === 1 ? 'Series' : 'Series Available'}
                      </p>
                      <a
                        href={targetHref}
                        class="mt-auto inline-flex items-center justify-center gap-[5px] pt-[0.8rem] pb-[0.15rem] text-[0.8rem] font-bold uppercase tracking-[0.6px] text-[#009FE3] transition-colors duration-200 hover:text-[#003B6D]"
                      >
                        <span>Explore Series</span>
                        <ArrowRight size={14} stroke-width={2.5} aria-hidden="true" />
                      </a>
                    </article>
                  );
                })}
              </div>
            </div>
          </section>
        );
      })
    }

    <!-- Bearing Isolators & Spares -->
    <section class="border-t border-[#e2e8f0] bg-white py-[3rem] min-[769px]:py-[4.5rem]">
      <div class="site-container space-y-[3rem]">
        {
          customSuperGroups.map((group) => (
            <div>
              <div class="mb-[1.5rem]">
                <span class="mb-[0.4rem] block text-[0.82rem] font-bold uppercase tracking-[1.5px] text-[#009FE3]">
                  ENGINEERED COMPONENTS
                </span>
                <h2 class="text-[1.6rem] font-bold text-[#003B6D]">
                  {group.title}
                </h2>
              </div>

              <div class="grid grid-cols-1 gap-[1.25rem] min-[577px]:grid-cols-2 min-[1025px]:grid-cols-3">
                {group.subcategories.flatMap((sub) =>
                  sub.products.map((prod) => (
                    <article class="flex flex-col justify-between rounded-[2px] border border-[#e2e8f0] border-t-4 border-t-[#009FE3] bg-[#F4F6F8] p-[1.5rem]">
                      <div>
                        <span class="mb-[0.35rem] block text-[0.74rem] font-bold uppercase tracking-[0.8px] text-[#64748b]">
                          {sub.title}
                        </span>
                        <h3 class="mb-[0.9rem] text-[1.1rem] font-bold text-[#003B6D]">
                          {prod.name}
                        </h3>
                        <div class="mb-[1.25rem] flex flex-wrap gap-[0.45rem]">
                          {prod.specs.map((spec) => (
                            <span class="rounded-[2px] border border-[#e2e8f0] bg-white px-[0.55rem] py-[0.25rem] text-[0.78rem] text-[#334155]">
                              <strong class="text-[#003B6D]">{spec.label}:</strong>{' '}
                              {spec.value}
                            </span>
                          ))}
                        </div>
                      </div>

                      <a
                        href={`/contact?inquiry=${encodeURIComponent(prod.name)}`}
                        class="inline-flex items-center gap-[5px] self-start text-[0.88rem] font-bold text-[#009FE3] transition-colors hover:text-[#003B6D]"
                      >
                        <span>Request Specification</span>
                        <ArrowRight size={14} stroke-width={2.2} aria-hidden="true" />
                      </a>
                    </article>
                  ))
                )}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
