---
import { Image } from 'astro:assets';
import { ArrowRight, ChevronRight, CircleCheck, FileDown } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import UtilityBar from '@/components/UtilityBar.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHeader from '@/components/PageHeader.astro';
import { SITE_CONFIG } from '@/config/site';
import {
  INDUSTRIES_LIST,
  resolveIndustryCategoryHref,
  type IndustryWithAsset,
} from '@/data/industriesData';

export function getStaticPaths() {
  return INDUSTRIES_LIST.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

interface Props {
  industry: IndustryWithAsset;
}

const { industry } = Astro.props;
const operatingEntries = Object.entries(industry.operatingConditions);
---

<BaseLayout
  title={`${industry.title} Sealing Solutions | ${SITE_CONFIG.brandName}`}
  description={industry.desc}
>
  <UtilityBar />
  <Header />
  <main id="main-content">
    <PageHeader
      kicker={industry.tag}
      title={industry.title}
      subtitle={industry.headline}
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Industries', href: '/industries' },
        { label: industry.title },
      ]}
    />

    <!-- Split Overview & Sector Image -->
    <section class="border-b border-[#e2e8f0] bg-[#F4F6F8] py-[3rem] min-[769px]:py-[4rem]">
      <div class="site-container grid grid-cols-1 items-center gap-[2rem] min-[961px]:grid-cols-2 min-[1201px]:gap-[3.5rem]">
        <div>
          <p class="mb-[1.75rem] text-[1rem] leading-[1.7] text-[#334155]">
            {industry.fullText}
          </p>
          <div class="flex flex-wrap gap-[0.85rem]">
            <a
              href={`/contact?inquiry=${encodeURIComponent(`${industry.title} Sealing Application`)}`}
              class="inline-block rounded-[4px] border-2 border-[#009FE3] bg-[#009FE3] px-[1.6rem] py-[0.75rem] text-[0.92rem] font-semibold text-white transition-colors duration-300 hover:border-[#007BB5] hover:bg-[#007BB5]"
            >
              Request Technical Proposal
            </a>
            <a
              href={SITE_CONFIG.brochurePath}
              download={SITE_CONFIG.brochureDownloadName}
              class="inline-flex items-center gap-[8px] rounded-none border border-[#003B6D] bg-transparent px-[1.4rem] py-[0.75rem] text-[0.92rem] font-semibold text-[#003B6D] transition-colors duration-300 hover:bg-[#003B6D] hover:text-white"
            >
              <FileDown size={16} stroke-width={2} aria-hidden="true" />
              <span>Engineering Brochure</span>
            </a>
          </div>
        </div>

        <div class="aspect-[16/10] w-full overflow-hidden rounded-[2px] border border-[#e2e8f0] bg-white shadow-[0_4px_20px_rgba(0,43,73,0.08)]">
          <Image
            src={industry.imageMeta}
            alt={industry.title}
            width={800}
            format="webp"
            quality={85}
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Main Technical Detail & Sidebar -->
    <section class="bg-white py-[3.5rem] min-[769px]:py-[5rem]">
      <div class="site-container grid grid-cols-1 gap-[2.5rem] min-[961px]:grid-cols-[2fr_1fr] min-[1201px]:gap-[3.5rem]">
        <!-- Left Main Technical Column -->
        <div class="space-y-[3rem]">
          <!-- Performance Statement -->
          <div class="rounded-[2px] border border-[#e2e8f0] border-l-4 border-l-[#009FE3] bg-[#F4F6F8] p-[1.5rem] min-[577px]:p-[1.75rem]">
            <span class="mb-[0.5rem] block text-[0.75rem] font-bold uppercase tracking-[1.2px] text-[#009FE3]">
              OFFICIAL RELIABLE INDUSTRIES PERFORMANCE STATEMENT
            </span>
            <p class="text-[1.05rem] font-semibold leading-[1.6] text-[#003B6D]">
              &ldquo;{industry.desc}&rdquo;
            </p>
          </div>

          <!-- Operating Envelope -->
          <div>
            <h2 class="mb-[1.25rem] text-[1.45rem] font-bold text-[#003B6D]">
              Engineering Operating Envelope
            </h2>
            <div class="grid grid-cols-1 gap-[1rem] min-[577px]:grid-cols-2">
              {
                operatingEntries.map(([label, val]) => (
                  <div class="rounded-[2px] border border-[#e2e8f0] bg-[#F4F6F8] p-[1.15rem]">
                    <span class="mb-[0.3rem] block text-[0.74rem] font-bold uppercase tracking-[0.8px] text-[#64748b]">
                      {label}
                    </span>
                    <span class="block text-[0.96rem] font-bold leading-[1.45] text-[#003B6D]">
                      {val}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Key Rotating Equipment -->
          <div>
            <h2 class="mb-[1.25rem] text-[1.45rem] font-bold text-[#003B6D]">
              Key Rotating Equipment Served
            </h2>
            <div class="grid grid-cols-1 gap-[0.85rem] min-[577px]:grid-cols-2">
              {
                industry.keyEquipment.map((eq) => (
                  <div class="flex items-center gap-[0.75rem] rounded-[2px] border border-[#e2e8f0] bg-white px-[1rem] py-[0.85rem]">
                    <CircleCheck
                      size={18}
                      stroke-width={2}
                      class="shrink-0 text-[#009FE3]"
                      aria-hidden="true"
                    />
                    <span class="text-[0.92rem] font-semibold text-[#334155]">
                      {eq}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Recommended Sealing Solutions -->
          <div>
            <h2 class="mb-[1.25rem] text-[1.45rem] font-bold text-[#003B6D]">
              Recommended Reliable Sealing Systems
            </h2>
            <div class="space-y-[1rem]">
              {
                industry.recommendedProducts.map((prod) => (
                  <article class="flex flex-col justify-between gap-[1rem] rounded-[2px] border border-[#e2e8f0] bg-[#F4F6F8] p-[1.25rem] min-[577px]:flex-row min-[577px]:items-center min-[577px]:p-[1.5rem]">
                    <div class="max-w-[520px]">
                      <h3 class="mb-[0.3rem] text-[1.1rem] font-bold text-[#003B6D]">
                        {prod.name}
                      </h3>
                      <p class="text-[0.9rem] leading-[1.5] text-[#64748b]">
                        {prod.desc}
                      </p>
                    </div>
                    <a
                      href={resolveIndustryCategoryHref(prod.category)}
                      class="inline-flex shrink-0 items-center gap-[6px] self-start rounded-[4px] bg-[#003B6D] px-[1.25rem] py-[0.65rem] text-[0.86rem] font-semibold text-white transition-colors duration-200 hover:bg-[#009FE3] min-[577px]:self-center"
                    >
                      <span>View Product Series</span>
                      <ArrowRight size={14} stroke-width={2} aria-hidden="true" />
                    </a>
                  </article>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Right Sidebar -->
        <aside class="space-y-[2rem]">
          <div class="rounded-[2px] bg-[#003B6D] p-[1.75rem] text-white shadow-[0_10px_30px_rgba(0,43,73,0.12)]">
            <h3 class="mb-[0.75rem] text-[1.25rem] font-bold text-white">
              Need An Engineered Solution?
            </h3>
            <p class="mb-[1.5rem] text-[0.92rem] leading-[1.6] text-[#cbd5e1]">
              Provide your pump / equipment details and fluid conditions. Our engineering team will supply dimensioned CAD drawings and an API-compliant seal proposal.
            </p>
            <a
              href={`/contact?inquiry=${encodeURIComponent(`${industry.title} Application`)}`}
              class="block w-full rounded-[4px] border-2 border-[#FFE600] bg-[#FFE600] px-[1.25rem] py-[0.75rem] text-center text-[0.92rem] font-semibold text-[#003B6D] transition-colors duration-300 hover:border-[#E6D000] hover:bg-[#E6D000]"
            >
              Request Quote
            </a>
            <div class="mt-[1rem] text-center text-[0.85rem] text-[#cbd5e1]">
              Direct Technical Line:{' '}
              <a
                href={`tel:${SITE_CONFIG.businessDetails.phones[0].replace(/[^+\d]/g, '')}`}
                class="font-semibold text-[#009FE3] hover:underline"
              >
                {SITE_CONFIG.businessDetails.phones[0]}
              </a>
            </div>
          </div>

          <div class="rounded-[2px] border border-[#e2e8f0] bg-[#F4F6F8] p-[1.5rem]">
            <h3 class="mb-[1rem] border-b-2 border-[#009FE3] pb-[0.65rem] text-[1.05rem] font-bold text-[#003B6D]">
              All Industries Served
            </h3>
            <ul class="space-y-[0.5rem]">
              {
                INDUSTRIES_LIST.map((item) => {
                  const isActive = item.slug === industry.slug;
                  return (
                    <li>
                      <a
                        href={`/industries/${item.slug}`}
                        aria-current={isActive ? 'page' : undefined}
                        class:list={[
                          'flex items-center justify-between rounded-[2px] border px-[0.85rem] py-[0.6rem] text-[0.88rem] font-semibold transition-colors duration-200',
                          isActive
                            ? 'border-[#009FE3] bg-[#009FE3] text-white'
                            : 'border-[#e2e8f0] bg-white text-[#334155] hover:border-[#009FE3] hover:text-[#003B6D]',
                        ]}
                      >
                        <span>{item.title}</span>
                        <ChevronRight
                          size={14}
                          stroke-width={2}
                          class={isActive ? 'text-white' : 'text-[#94A3B8]'}
                          aria-hidden="true"
                        />
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
