---
import BaseLayout from '@/layouts/BaseLayout.astro';
import UtilityBar from '@/components/UtilityBar.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHeader from '@/components/PageHeader.astro';
import { SITE_CONFIG } from '@/config/site';
import { TRADE_EVENTS } from '@/data/companyData';
---

<BaseLayout
  title={`Events & Trade Fairs | ${SITE_CONFIG.brandName}`}
  description="Meet Reliable Industries at leading international engineering exhibitions, trade fairs, and oil & gas conferences around the globe."
>
  <UtilityBar />
  <Header />
  <main id="main-content">
    <PageHeader
      kicker="GLOBAL EXHIBITIONS & CONFERENCES"
      title="Events & Trade Fairs"
      subtitle="Connect directly with our engineering directors and explore live product demonstrations at international trade exhibitions."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Events & Trade Fairs' },
      ]}
      align="center"
    />

    <section class="bg-[#F4F6F8] py-[3.5rem] min-[769px]:py-[5rem]">
      <div class="site-container">
        <div class="mx-auto max-w-[960px] space-y-[1.5rem]">
          {
            TRADE_EVENTS.map((ev) => (
              <article class="grid grid-cols-1 items-center gap-[1.5rem] rounded-[2px] border border-[#e2e8f0] border-l-4 border-l-[#009FE3] bg-white p-[1.5rem] shadow-[0_4px_20px_rgba(0,43,73,0.05)] min-[769px]:grid-cols-[150px_1fr_auto] min-[769px]:p-[2rem]">
                <div class="rounded-[2px] border border-[#e2e8f0] bg-[#F4F6F8] p-[0.9rem] text-center">
                  <div class="text-[1.45rem] font-extrabold text-[#009FE3]">
                    {ev.month}
                  </div>
                  <div class="text-[1.15rem] font-bold text-[#003B6D]">
                    {ev.days}
                  </div>
                  <div class="text-[0.8rem] font-semibold text-[#64748b]">
                    {ev.year}
                  </div>
                </div>

                <div>
                  <span class="mb-[0.3rem] block text-[0.76rem] font-bold uppercase tracking-[0.8px] text-[#009FE3]">
                    {ev.sector}
                  </span>
                  <h2 class="mb-[0.45rem] text-[1.25rem] font-bold text-[#003B6D]">
                    {ev.title}
                  </h2>
                  <p class="mb-[0.4rem] text-[0.9rem] font-semibold text-[#64748b]">
                    {ev.location}
                  </p>
                  <p class="text-[0.92rem] leading-[1.55] text-[#334155]">
                    {ev.summary}
                  </p>
                </div>

                <div>
                  <a
                    href={`/contact?inquiry=${encodeURIComponent(`Book Meeting at ${ev.title}`)}`}
                    class="inline-block rounded-[4px] border-2 border-[#003B6D] bg-[#003B6D] px-[1.35rem] py-[0.65rem] text-[0.88rem] font-semibold whitespace-nowrap text-white transition-colors duration-300 hover:border-[#009FE3] hover:bg-[#009FE3]"
                  >
                    Book Meeting
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
