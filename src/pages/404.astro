---
import { ArrowRight, House, Layers, PhoneCall, Wrench } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import UtilityBar from '@/components/UtilityBar.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_CONFIG } from '@/config/site';

const quickDestinations = [
  {
    icon: House,
    title: 'Home Page',
    description: 'Return to the Reliable Industries overview and product highlights.',
    href: '/',
    cta: 'Go to Home',
  },
  {
    icon: Layers,
    title: 'Product Catalogue',
    description: 'Explore 46 mechanical seals, rotary joints, and support systems.',
    href: '/products',
    cta: 'Browse Products',
  },
  {
    icon: Wrench,
    title: 'Technical Services',
    description: 'Consultation, seal refurbishment, training & preventive maintenance.',
    href: '/services',
    cta: 'View Services',
  },
  {
    icon: PhoneCall,
    title: 'Engineering Support',
    description: 'Contact our Mumbai engineering team for quotes or urgent spares.',
    href: '/contact',
    cta: 'Contact Us',
  },
];
---

<BaseLayout
  title={`404 — Page Not Found | ${SITE_CONFIG.brandName}`}
  description="The requested page could not be found on the Reliable Industries website."
  noindex={true}
>
  <UtilityBar />
  <Header />
  <main id="main-content">
    <section class="border-b border-[#e2e8f0] bg-[#F4F6F8] py-[4rem] min-[769px]:py-[5.5rem]">
      <div class="site-container text-center">
        <span class="mb-[0.75rem] inline-block rounded-[2px] bg-[#003B6D] px-[0.9rem] py-[0.3rem] text-[0.78rem] font-bold uppercase tracking-[1.5px] text-[#FFE600]">
          ERROR 404
        </span>
        <h1 class="mx-auto mb-[1rem] max-w-[680px] text-[2rem] font-bold leading-[1.15] text-[#003B6D] min-[769px]:text-[2.75rem]">
          The Page You Requested Could Not Be Found
        </h1>
        <p class="mx-auto mb-[2rem] max-w-[580px] text-[1rem] leading-[1.65] text-[#334155]">
          The URL may have changed or been mistyped. Use the links below to jump directly to our mechanical seal catalogue, industries, or engineering team.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-[1rem]">
          <a
            href="/"
            class="inline-block rounded-[4px] border-2 border-[#003B6D] bg-[#003B6D] px-[1.75rem] py-[0.75rem] text-[0.95rem] font-semibold text-white transition-colors duration-300 hover:border-[#009FE3] hover:bg-[#009FE3]"
          >
            Back to Home
          </a>
          <a
            href="/products"
            class="inline-block rounded-[4px] border-2 border-[#003B6D] bg-white px-[1.75rem] py-[0.75rem] text-[0.95rem] font-semibold text-[#003B6D] transition-colors duration-300 hover:bg-[#003B6D] hover:text-white"
          >
            Explore Catalogue
          </a>
        </div>
      </div>
    </section>

    <section class="bg-white py-[3.5rem] min-[769px]:py-[4.5rem]">
      <div class="site-container">
        <div class="grid grid-cols-1 gap-[1.5rem] min-[577px]:grid-cols-2 min-[1025px]:grid-cols-4">
          {
            quickDestinations.map((item) => {
              const Icon = item.icon;
              return (
                <a
                  href={item.href}
                  class="group flex flex-col justify-between rounded-[2px] border border-[#e2e8f0] border-t-[3px] border-t-[#009FE3] bg-white p-[1.5rem] transition-shadow duration-300 hover:shadow-[0_8px_24px_rgba(0,43,73,0.1)]"
                >
                  <div>
                    <Icon
                      size={26}
                      stroke-width={1.8}
                      class="mb-[0.85rem] text-[#003B6D] transition-colors group-hover:text-[#009FE3]"
                      aria-hidden="true"
                    />
                    <h2 class="mb-[0.45rem] text-[1.1rem] font-bold text-[#003B6D]">
                      {item.title}
                    </h2>
                    <p class="mb-[1rem] text-[0.88rem] leading-[1.55] text-[#334155]">
                      {item.description}
                    </p>
                  </div>
                  <span class="inline-flex items-center gap-[5px] text-[0.86rem] font-semibold text-[#009FE3] group-hover:text-[#003B6D]">
                    <span>{item.cta}</span>
                    <ArrowRight size={14} stroke-width={2.2} aria-hidden="true" />
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
