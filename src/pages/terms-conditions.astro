---
import LegalDocument from '@/components/LegalDocument.astro';
import { SITE_CONFIG } from '@/config/site';

const sections = [
  {
    heading: '1. Quotations & Order Acceptance',
    body: 'All formal commercial quotations issued by Reliable Industries are valid for a period of 30 days unless explicitly specified otherwise. Purchase orders are binding upon formal written order confirmation from Reliable Industries.',
  },
  {
    heading: '2. Manufacturing & Quality Inspection',
    body: 'All items are manufactured in conformance with agreed purchase specifications and international standards (API 682, ISO 9001). Pre-dispatch inspection, MTR certification, and hydrostatic test reports will be supplied in accordance with the purchase agreement.',
  },
  {
    heading: '3. Warranty & Guarantee',
    body: 'Reliable Industries warrants that all products supplied are free from defects in material and workmanship for a period of 12 months from the date of commissioning or 18 months from the date of shipment, whichever occurs first, provided products are installed, flushed, and operated strictly within certified operating parameters.',
  },
  {
    heading: '4. Force Majeure & Limitation of Liability',
    body: 'Reliable Industries shall not be held liable for failure to perform or delays resulting from acts of God, extreme raw material embargoes, war, or governmental import/export sanctions. Total aggregate liability under any claim shall not exceed the purchase price of the specific item supplied.',
  },
];
---

<LegalDocument
  seoTitle={`Terms & Conditions of Sale | ${SITE_CONFIG.brandName}`}
  seoDescription="Review the terms and conditions of commercial quotation, manufacture, warranty, and supply of Reliable Industries mechanical seals and systems."
  kicker="COMMERCIAL & CONTRACT TERMS"
  pageTitle="Terms & Conditions of Sale"
  subtitle="Standard terms governing quotations, orders, fabrication, warranties, and supply contracts."
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Terms & Conditions' }]}
  sections={sections}
  footerNoticeHtml={`For commercial contracts and legal queries, contact <a href="mailto:${SITE_CONFIG.businessDetails.departmentEmails.contracts}" class="font-semibold text-[#009FE3] hover:text-[#003B6D]">${SITE_CONFIG.businessDetails.departmentEmails.contracts}</a>.`}
/>
