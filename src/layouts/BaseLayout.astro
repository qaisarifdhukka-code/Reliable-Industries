---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@/styles/global.css';
import SeoHead, { type Props as SeoProps } from '@/components/seo/SeoHead.astro';

export interface Props extends SeoProps {}

const seoProps = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead {...seoProps} />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:bg-[#003B6D] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
