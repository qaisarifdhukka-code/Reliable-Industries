---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import MobileSliderControls from '@/components/MobileSliderControls.astro';
import productSeal1 from '@/assets/images/product_seal_1_1790081847592.jpg';
import waterRotaryImg from '@/assets/images/waterrotatingunion.jpg';
import productSeal2 from '@/assets/images/product_seal_2_1790081868989.jpg';

interface ProductCardItem {
  id: string;
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  description: string;
  href: string;
}

const productCards: ProductCardItem[] = [
  {
    id: 'mechanical-seals',
    image: productSeal1,
    imageAlt: 'Mechanical Seals',
    title: 'Mechanical Seals',
    description:
      'High-end standard and customized seals for pumps, agitators, and compressors.',
    href: '/products/multi-spring-series-seal/inside-mounting-multi-spring-seal-series-33',
  },
  {
    id: 'rotary-joints',
    image: waterRotaryImg,
    imageAlt: 'Rotary Joints',
    title: 'Rotary Joints',
    description:
      'Reliable monoflow and duoflow rotating unions engineered for water, steam, hot oil, and hydraulic applications.',
    href: '/products/water-rotary-joints',
  },
  {
    id: 'seal-support-systems',
    image: productSeal2,
    imageAlt: 'Seal Support Systems',
    title: 'Seal Support Systems',
    description:
      'State-of-the-art systems to ensure optimal operating conditions for your seals.',
    href: '/products/thermosyphon/thermosyphon-3',
  },
];
---

<section class="bg-[#F4F6F8] py-[3.5rem] min-[769px]:py-[5rem]">
  <div class="site-container">
    <div class="mb-[2rem] min-[769px]:mb-[3rem]">
      <span class="mb-[0.5rem] block text-[0.85rem] font-bold uppercase tracking-[1.5px] text-[#009FE3]">
        OUR PORTFOLIO
      </span>
      <h2 class="mb-[1.5rem] text-[1.75rem] font-bold leading-[1.2] text-[#003B6D] min-[769px]:text-[2.2rem]">
        Reliable Sealing Solutions
      </h2>
    </div>

    <div
      data-mobile-slider-track="portfolio"
      class="max-[768px]:flex max-[768px]:flex-nowrap max-[768px]:gap-[1rem] max-[768px]:overflow-x-auto max-[768px]:snap-x max-[768px]:snap-mandatory max-[768px]:pb-[4px] max-[768px]:scroll-smooth max-[768px]:[scrollbar-width:none] max-[768px]:[&::-webkit-scrollbar]:hidden min-[769px]:grid min-[769px]:grid-cols-2 min-[769px]:gap-[1.5rem] min-[1025px]:grid-cols-4"
    >
      {
        productCards.map((card) => (
          <article class="flex flex-col overflow-hidden rounded-[2px] border border-[#e2e8f0] bg-white shadow-[0_4px_20px_rgba(0,43,73,0.05)] transition-[transform,box-shadow] duration-300 ease-in-out max-[768px]:w-[84%] max-[768px]:shrink-0 max-[768px]:snap-start hover:-translate-y-[5px] hover:shadow-[0_12px_30px_rgba(0,43,73,0.1)]">
            <div class="aspect-[4/3] w-full overflow-hidden bg-white">
              <Image
                src={card.image}
                alt={card.imageAlt}
                width={640}
                format="webp"
                quality={85}
                class="h-full w-full object-contain mix-blend-multiply"
              />
            </div>
            <div class="flex grow flex-col border-t border-[#F4F6F8] p-[1.5rem]">
              <h3 class="mb-[0.75rem] text-[1.25rem] font-bold text-[#003B6D]">
                {card.title}
              </h3>
              <p class="mb-[1.5rem] grow text-[0.95rem] text-[#334155]">
                {card.description}
              </p>
              <a
                href={card.href}
                class="inline-flex items-center gap-[5px] self-start font-semibold text-[#009FE3] transition-colors duration-300 hover:text-[#003B6D]"
              >
                Learn more &#8594;
              </a>
            </div>
          </article>
        ))
      }

      <article class="flex flex-col justify-center overflow-hidden rounded-[2px] border border-[#e2e8f0] bg-[#003B6D] p-[2rem] text-white shadow-[0_4px_20px_rgba(0,43,73,0.05)] transition-[transform,box-shadow] duration-300 ease-in-out max-[768px]:w-[84%] max-[768px]:shrink-0 max-[768px]:snap-start hover:-translate-y-[5px] hover:shadow-[0_12px_30px_rgba(0,43,73,0.1)]">
        <div>
          <h3 class="mb-[0.75rem] text-[1.25rem] font-bold text-white">
            Custom Engineered Solutions
          </h3>
          <p class="mb-[2rem] text-[#cbd5e1]">
            Need a specialized sealing solution tailored to your exact specifications? Our engineering team is ready to assist.
          </p>
          <a
            href="/contact?inquiry=Custom%20Engineered%20Solutions"
            class="inline-block cursor-pointer rounded-[4px] border-2 border-[#FFE600] bg-[#FFE600] px-[1.8rem] py-[0.8rem] text-center text-[0.95rem] font-semibold text-[#003B6D] transition-all duration-300 hover:border-[#E6D000] hover:bg-[#E6D000]"
          >
            Inquire now
          </a>
        </div>
      </article>
    </div>

    <MobileSliderControls
      sliderId="portfolio"
      count={productCards.length + 1}
      label="Sealing Solutions"
    />
  </div>
</section>
