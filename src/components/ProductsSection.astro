---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import MobileSliderControls from '@/components/MobileSliderControls.astro';
import productSeal1 from '@/assets/images/product_seal_1_1790081847592.jpg';
import waterRotaryImg from '@/assets/images/waterrotatingunion.jpg';
import productSeal2 from '@/assets/images/seal_support_system.jpg';

interface ProductCardItem {
  id: string;
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  description: string;
  href: string;
}

const productCards: ProductCardItem[] = [
  {
    id: 'mechanical-seals',
    image: productSeal1,
    imageAlt: 'Mechanical Seals',
    title: 'Mechanical Seals',
    description:
      'High-end standard and customized seals for pumps, agitators, and compressors.',
    href: '/products/multi-spring-series-seal/inside-mounting-multi-spring-seal-series-33',
  },
  {
    id: 'rotary-joints',
    image: waterRotaryImg,
    imageAlt: 'Rotary Joints',
    title: 'Rotary Joints',
    description:
      'Reliable monoflow and duoflow rotating unions engineered for water, steam, hot oil, and hydraulic applications.',
    href: '/products/water-rotary-joints',
  },
  {
    id: 'seal-support-systems',
    image: productSeal2,
    imageAlt: 'Seal Support Systems',
    title: 'Seal Support Systems',
    description:
      'State-of-the-art systems to ensure optimal operating conditions for your seals.',
    href: '/products/thermosyphon/thermosyphon-3',
  },
];
---

<section class="bg-[#F4F6F8] py-[3.5rem] min-[769px]:py-[5rem]">
  <div class="site-container">
    <div class="mb-[2.5rem] text-center min-[769px]:mb-[3rem]">
      <span class="mb-[0.5rem] block text-[0.85rem] font-bold uppercase tracking-[1.5px] text-[#009FE3]">
        OUR PORTFOLIO
      </span>
      <h2 class="text-[1.75rem] font-bold leading-[1.2] text-[#003B6D] min-[769px]:text-[2.2rem]">
        Our Products
      </h2>
    </div>

    <div
      data-mobile-slider-track="portfolio"
      class="max-[768px]:flex max-[768px]:flex-nowrap max-[768px]:gap-[1rem] max-[768px]:overflow-x-auto max-[768px]:snap-x max-[768px]:snap-mandatory max-[768px]:pb-[4px] max-[768px]:scroll-smooth max-[768px]:[scrollbar-width:none] max-[768px]:[&::-webkit-scrollbar]:hidden min-[769px]:grid min-[769px]:grid-cols-3 min-[769px]:gap-[2rem]"
    >
      {
        productCards.map((card) => (
          <a
            href={card.href}
            class="group flex flex-col items-center max-[768px]:w-[80%] max-[768px]:shrink-0 max-[768px]:snap-start"
          >
            <div class="flex aspect-[4/3] w-full items-center justify-center overflow-hidden rounded-[4px] border border-[#e2e8f0] bg-white p-[2rem] shadow-[0_4px_20px_rgba(0,43,73,0.04)] transition-[transform,box-shadow] duration-300 ease-in-out group-hover:-translate-y-[4px] group-hover:shadow-[0_12px_30px_rgba(0,43,73,0.1)]">
              <Image
                src={card.image}
                alt={card.imageAlt}
                format="webp"
                quality={85}
                class="h-auto max-h-full w-auto max-w-full object-contain transition-transform duration-300 ease-in-out group-hover:scale-[1.03]"
              />
            </div>
            <h3 class="mt-[1.1rem] text-center text-[1.1rem] font-bold text-[#003B6D] transition-colors duration-300 group-hover:text-[#009FE3]">
              {card.title}
            </h3>
          </a>
        ))
      }
    </div>

    <MobileSliderControls
      sliderId="portfolio"
      count={productCards.length}
      label="Our Products"
    />
  </div>
</section>
