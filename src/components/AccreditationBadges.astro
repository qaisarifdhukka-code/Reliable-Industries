---
import { Image } from 'astro:assets';
import qroLogo from '@/assets/images/qro_logo.png';
import egacLogo from '@/assets/images/egac_logo.png';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'flex items-center gap-[12px] max-[480px]:gap-[5px]',
    className,
  ]}
  aria-label="QRO, EGAC Accredited, and IAF ISO 9001:2015 Certifications"
>
  <Image
    src={qroLogo}
    alt="QRO — Quality Research Organization"
    height={96}
    quality={95}
    format="png"
    loading="eager"
    class="h-[34px] w-auto shrink-0 object-contain max-[480px]:h-[16px]"
  />

  <Image
    src={egacLogo}
    alt="EGAC Accredited"
    height={96}
    quality={95}
    format="png"
    loading="eager"
    class="h-[34px] w-auto shrink-0 object-contain max-[480px]:h-[16px]"
  />

  <img
    src="/iaf_logo-1.svg"
    alt="IAF Member of Multilateral Recognition Arrangement"
    width="152"
    height="95"
    loading="eager"
    decoding="async"
    class="h-[34px] w-auto shrink-0 object-contain max-[480px]:h-[16px]"
  />

  <span class="border-l border-[#cbd5e1] pl-[10px] text-[0.75rem] font-bold tracking-[0.4px] whitespace-nowrap text-[#334155] max-[480px]:pl-[4px] max-[480px]:text-[0.45rem]">
    ISO 9001 : 2015
  </span>
</div>
