---
import BaseLayout from '@/layouts/BaseLayout.astro';
import UtilityBar from '@/components/UtilityBar.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHeader, { type BreadcrumbItem } from '@/components/PageHeader.astro';

export interface LegalSectionItem {
  heading: string;
  body: string;
  bullets?: string[];
}

export interface Props {
  seoTitle: string;
  seoDescription: string;
  kicker: string;
  pageTitle: string;
  subtitle: string;
  breadcrumbs: BreadcrumbItem[];
  sections: LegalSectionItem[];
  footerNoticeHtml?: string;
}

const {
  seoTitle,
  seoDescription,
  kicker,
  pageTitle,
  subtitle,
  breadcrumbs,
  sections,
  footerNoticeHtml,
} = Astro.props;
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <UtilityBar />
  <Header />
  <main id="main-content">
    <PageHeader
      kicker={kicker}
      title={pageTitle}
      subtitle={subtitle}
      breadcrumbs={breadcrumbs}
    />

    <section class="bg-[#F4F6F8] py-[3rem] min-[769px]:py-[4.5rem]">
      <div class="site-container">
        <article class="mx-auto max-w-[900px] rounded-[2px] border border-[#e2e8f0] bg-white p-[1.5rem] shadow-[0_4px_20px_rgba(0,43,73,0.05)] min-[577px]:p-[2.5rem]">
          <div class="space-y-[2rem]">
            {
              sections.map((section) => (
                <section>
                  <h2 class="mb-[0.75rem] text-[1.25rem] font-bold text-[#003B6D] min-[769px]:text-[1.35rem]">
                    {section.heading}
                  </h2>
                  <p class="text-[0.96rem] leading-[1.75] text-[#334155]">
                    {section.body}
                  </p>
                  {section.bullets && section.bullets.length > 0 && (
                    <ul class="mt-[0.75rem] list-disc space-y-[0.45rem] pl-[1.4rem] text-[0.95rem] leading-[1.65] text-[#334155]">
                      {section.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  )}
                </section>
              ))
            }
          </div>

          {
            footerNoticeHtml && (
              <div
                class="mt-[2.25rem] rounded-[2px] border border-[#e2e8f0] border-l-4 border-l-[#009FE3] bg-[#F4F6F8] px-[1.25rem] py-[1rem] text-[0.92rem] leading-[1.6] text-[#334155]"
                set:html={footerNoticeHtml}
              />
            )
          }
        </article>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
