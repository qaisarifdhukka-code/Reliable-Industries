---
import { SITE_CONFIG } from '@/config/site';
import CertificatesCarousel, {
  type CertificateCardData,
} from '@/components/CertificatesCarousel';

const certificateItems: { label: string; href: string }[] = [
  {
    label: 'ISO 9001:2015 — QRO Certification (2024–2027)',
    href: '/certificates/iso-9001-2024-2027.pdf',
  },
  {
    label: 'ISO 9001:2015 — QACS International (Up to 2024)',
    href: '/certificates/iso-9001-up-to-2024.pdf',
  },
];

const certificateCards: CertificateCardData[] = [
  {
    id: 'cert-iso-9001-qro',
    category: 'QRO • EGAC • IAF',
    title: 'Certificate of Registration',
    regNumber: 'Certificate No. 3050240618172Q',
    organizationLabel: 'This is to certify that',
    organization: SITE_CONFIG.brandName,
    standardCode: 'ISO 9001:2015',
    description:
      'Manufacturer and supplier of mechanical shaft seals, rotary joints and related spares. (2024–2027)',
    sealLabel: 'QRO ISO',
    signatoryName: 'QRO Certification LLP',
    signatoryRole: 'Head of Certification',
    accentType: 'cyan',
    pdfUrl: '/certificates/iso-9001-2024-2027.pdf',
  },
  {
    id: 'cert-iso-9001-qacs',
    category: 'QACS International • IAS • IAF',
    title: 'Certificate of Registration',
    regNumber: 'Certificate No. QAIS-Q-RI-05.18.036',
    organizationLabel: 'This certifies that',
    organization: SITE_CONFIG.brandName,
    standardCode: 'ISO 9001:2015',
    description:
      'Manufacturer and supplier of mechanical shaft seals, rotary joints and related spares. EA Code: 18 (Up to 2024).',
    sealLabel: 'QACS ISO',
    signatoryName: 'QACS International Pvt. Ltd.',
    signatoryRole: 'Authorised Signatory',
    accentType: 'navy',
    pdfUrl: '/certificates/iso-9001-up-to-2024.pdf',
  },
];
---

<section class="bg-white py-[3.5rem] min-[769px]:py-[5rem]">
  <div class="site-container grid grid-cols-1 items-center gap-[2.5rem] min-[1025px]:grid-cols-[360px_1fr] min-[1201px]:grid-cols-[380px_1fr] min-[1201px]:gap-[3rem]">
    <!-- Left Compliance Checklist Card -->
    <div class="rounded-[2px] border border-[#e2e8f0] border-t-4 border-t-[#009FE3] bg-[#F4F6F8] p-[1.5rem] min-[577px]:p-[2.25rem]">
      <h2 class="mb-[1.5rem] text-[1.5rem] font-bold uppercase tracking-[0.5px] leading-[1.2] text-[#003B6D] min-[769px]:text-[1.75rem]">
        CERTIFICATES
      </h2>
      <ul class="grid grid-cols-1 gap-x-[1.5rem] gap-y-[0.75rem] min-[577px]:grid-cols-2 min-[1025px]:grid-cols-1">
        {
          certificateItems.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-[0.65rem] text-[0.9rem] font-medium leading-[1.45] text-[#334155] transition-colors duration-200 hover:text-[#009FE3]"
              >
                <span
                  aria-hidden="true"
                  class="h-[6px] w-[6px] shrink-0 rounded-full bg-[#009FE3]"
                />
                <span class="underline decoration-[#cbd5e1] underline-offset-4 hover:decoration-[#009FE3]">
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Right Interactive Stacked Certificates Deck -->
    <CertificatesCarousel client:visible certificates={certificateCards} />
  </div>
</section>
