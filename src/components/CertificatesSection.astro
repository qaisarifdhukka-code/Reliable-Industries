---
import { SITE_CONFIG } from '@/config/site';
import CertificatesCarousel, {
  type CertificateCardData,
} from '@/components/CertificatesCarousel';

const certificateItems: string[] = [
  'API Spec Q1 Certified',
  'ASME U Stamp 115366 BPV',
  'National Board "NB" Certificate',
  'ISO 19443 Nuclear Quality',
  'APIQR ISO 9001:2015',
  'ISO 29001:2020 Petroleum Systems',
  'ATEX - 2014/34/EU Directive',
  'TRCU - 012 / 010 & 032',
  'PED - CE Pressure Equipment',
  'ISO 9001:2015 Quality Management',
  'ISO 14001:2015 Environmental System',
  'ISO 45001:2018 Health & Safety',
  'EU 1935/2004 & FDA Compliant',
  'REACH SVHC & RoHS Compliant',
];

const certificateCards: CertificateCardData[] = [
  {
    id: 'cert-api-q1',
    category: 'APIQR • API Monogram',
    title: 'Certificate of Authority',
    regNumber: 'Registration No. API-682-0412',
    organizationLabel: 'Awarded to',
    organization: SITE_CONFIG.brandName,
    standardCode: 'API Spec Q1 / ISO 9001',
    description:
      'Design and manufacture of industrial mechanical seals, cartridge assemblies, and seal auxiliary systems.',
    sealLabel: 'API Q1',
    signatoryName: 'R. Sharma',
    signatoryRole: 'VP Quality Assurance',
    accentType: 'cyan',
  },
  {
    id: 'cert-asme',
    category: 'ASME Boiler & Pressure',
    title: 'Certificate of Authorization',
    regNumber: 'ASME "U" Stamp No. 115366',
    organizationLabel: 'Certified Manufacturer',
    organization: SITE_CONFIG.brandName,
    standardCode: 'ASME Section VIII, Div. 1',
    description:
      'Fabrication and assembly of pressure vessel equipment, thermosyphon vessels, and high-pressure barrier systems.',
    sealLabel: 'ASME U',
    signatoryName: 'M. Jenkins',
    signatoryRole: 'Managing Director',
    accentType: 'navy',
  },
  {
    id: 'cert-iso-9001',
    category: 'Quality Management',
    title: 'Certificate of Registration',
    regNumber: 'Certificate No. ISO-9001-2015-RI',
    organizationLabel: 'This certifies that',
    organization: SITE_CONFIG.brandName,
    standardCode: 'ISO 9001:2015',
    description:
      'Comprehensive Quality Management Systems for precision engineering, custom seal manufacturing, and zero-defect quality control.',
    sealLabel: 'ISO 9001',
    signatoryName: 'Dr. H. Mehta',
    signatoryRole: 'Lead Auditor / Registrar',
    accentType: 'cyan',
  },
  {
    id: 'cert-atex',
    category: 'ATEX 2014/34/EU • Ex',
    title: 'EU-Type Examination',
    regNumber: 'Notified Body No. 0081 / ATEX',
    organizationLabel: 'Equipment Compliance',
    organization: SITE_CONFIG.brandName,
    standardCode: 'II 2 GD c IIC T4...T1',
    description:
      'Explosion-proof mechanical seal design for dangerous and explosive gas / dust environments in petrochemical plants.',
    sealLabel: 'Ex ATEX',
    signatoryName: 'A. Dupont',
    signatoryRole: 'Safety Director',
    accentType: 'navy',
  },
  {
    id: 'cert-ehs',
    category: 'Environmental & Safety',
    title: 'Integrated EHS Certificate',
    regNumber: 'Registration No. EHS-45001-14001',
    organizationLabel: 'Certified Organization',
    organization: SITE_CONFIG.brandName,
    standardCode: 'ISO 14001:2015 & 45001:2018',
    description:
      'Implementation of international occupational safety and environmentally sustainable seal manufacturing practices.',
    sealLabel: 'EHS CERT',
    signatoryName: 'S. Patel',
    signatoryRole: 'Head of Compliance',
    accentType: 'cyan',
  },
];
---

<section class="bg-white py-[3.5rem] min-[769px]:py-[5rem]">
  <div class="site-container grid grid-cols-1 items-center gap-[2.5rem] min-[1025px]:grid-cols-[360px_1fr] min-[1201px]:grid-cols-[380px_1fr] min-[1201px]:gap-[3rem]">
    <!-- Left Compliance Checklist Card -->
    <div class="rounded-[2px] border border-[#e2e8f0] border-t-4 border-t-[#009FE3] bg-[#F4F6F8] p-[1.5rem] min-[577px]:p-[2.25rem]">
      <h2 class="mb-[1.5rem] text-[1.5rem] font-bold uppercase tracking-[0.5px] leading-[1.2] text-[#003B6D] min-[769px]:text-[1.75rem]">
        CERTIFICATES
      </h2>
      <ul class="grid grid-cols-1 gap-x-[1.5rem] gap-y-[0.75rem] min-[577px]:grid-cols-2 min-[1025px]:grid-cols-1">
        {
          certificateItems.map((item) => (
            <li class="flex items-center gap-[0.65rem] text-[0.9rem] font-medium leading-[1.45] text-[#334155]">
              <span
                aria-hidden="true"
                class="h-[6px] w-[6px] shrink-0 rounded-full bg-[#009FE3]"
              />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Right Interactive Stacked Certificates Deck -->
    <CertificatesCarousel client:visible certificates={certificateCards} />
  </div>
</section>
