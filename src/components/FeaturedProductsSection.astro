---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import MobileSliderControls from '@/components/MobileSliderControls.astro';
import agitatorImg from '@/assets/images/featured/agiator_01.png';
import highTempImg from '@/assets/images/featured/high_temp_seal_01.jpg';
import hydraulicImg from '@/assets/images/featured/hydrolic_1.png';
import rotaryUnionImg from '@/assets/images/featured/deofolwrotatingunion.png';

interface FeaturedProduct {
  id: string;
  title: string;
  subtitle: string;
  image: ImageMetadata;
  imageAlt: string;
  href: string;
}

const featuredProducts: FeaturedProduct[] = [
  {
    id: 'agitator-seal',
    title: 'Agitator Seal',
    subtitle: 'Agitator Seal',
    image: agitatorImg,
    imageAlt: 'Agitator Seal mechanical seal unit',
    href: '/products/agitator-seal/agitator-seal-2',
  },
  {
    id: 'high-temp-seal-series',
    title: 'High Temp Seal Series',
    subtitle: 'High Temp Seal',
    image: highTempImg,
    imageAlt: 'High Temp Seal Series mechanical seal',
    href: '/products/high-temp-seal/high-temp-seal-series-5',
  },
  {
    id: 'rmf-h-100',
    title: 'RMF-H-100 Hydraulic Union',
    subtitle: 'Hydraulic Rotary Joints',
    image: hydraulicImg,
    imageAlt: 'RMF-H-100 Hydraulic Rotating Union',
    href: '/products/hydrolic-rotary-joints/rmf-h-100-this-is-hydraulic-rotating-union-29',
  },
  {
    id: 'rdf-80',
    title: 'RDF-80 Duoflow Union',
    subtitle: 'Water Rotary Joints',
    image: rotaryUnionImg,
    imageAlt: 'RDF-80 Duoflow Rotating Union',
    href: '/products/water-rotary-joints/rdf-80-this-is-deofolw-rotating-union-17',
  },
];
---

<section class="bg-[#F4F6F8] py-[3rem] min-[769px]:py-[4.5rem]">
  <div class="site-container">
    <div class="mb-[1.75rem] flex flex-col items-start justify-between gap-[1rem] min-[577px]:flex-row min-[577px]:items-end min-[769px]:mb-[2.5rem]">
      <div>
        <span class="mb-[0.5rem] block text-[0.85rem] font-bold uppercase tracking-[1.5px] text-[#009FE3]">
          PRODUCT HIGHLIGHTS
        </span>
        <h2 class="text-[1.75rem] font-bold leading-[1.2] text-[#003B6D] min-[769px]:text-[2.2rem]">
          Featured Products
        </h2>
      </div>
      <a
        href="/products"
        class="inline-block shrink-0 rounded-none border border-[#003B6D] bg-transparent px-[1.5rem] py-[0.6rem] text-[0.9rem] font-semibold text-[#003B6D] transition-all duration-300 hover:bg-[#003B6D] hover:text-white"
      >
        View Products
      </a>
    </div>

    <div
      data-mobile-slider-track="featured-products"
      class="max-[768px]:flex max-[768px]:flex-nowrap max-[768px]:gap-[1rem] max-[768px]:overflow-x-auto max-[768px]:snap-x max-[768px]:snap-mandatory max-[768px]:pb-[4px] max-[768px]:scroll-smooth max-[768px]:[scrollbar-width:none] max-[768px]:[&::-webkit-scrollbar]:hidden min-[769px]:grid min-[769px]:grid-cols-2 min-[769px]:gap-[1.5rem] min-[1025px]:grid-cols-4"
    >
      {
        featuredProducts.map((product) => (
          <article class="flex flex-col items-center rounded-[2px] border border-[#dce4ec] bg-white p-[1.25rem] pb-[1.5rem] text-center shadow-[0_4px_20px_rgba(0,43,73,0.06)] transition-[transform,box-shadow] duration-300 ease-in-out max-[768px]:w-[82%] max-[768px]:shrink-0 max-[768px]:snap-start hover:-translate-y-[4px] hover:shadow-[0_12px_28px_rgba(0,43,73,0.1)]">
            <div class="aspect-[4/3] w-full overflow-hidden rounded-[2px] border border-[#e6ebf1] bg-[#F4F6F8]">
              <Image
                src={product.image}
                alt={product.imageAlt}
                width={640}
                format="webp"
                quality={85}
                class="block h-full w-full object-cover object-center"
              />
            </div>

            <h3 class="mt-[1.2rem] text-[0.96rem] font-bold uppercase leading-[1.3] tracking-[0.3px] text-[#003B6D]">
              {product.title}
            </h3>
            <p class="mt-[0.3rem] text-[0.88rem] leading-[1.4] text-[#64748b]">
              {product.subtitle}
            </p>
            <a
              href={product.href}
              class="mt-auto inline-flex items-center justify-center gap-[5px] pt-[0.8rem] pb-[0.15rem] text-[0.8rem] font-bold uppercase tracking-[0.6px] text-[#009FE3] transition-colors duration-300 hover:text-[#003B6D]"
            >
              <span>View Specs</span>
              <ArrowRight size={14} stroke-width={2.5} aria-hidden="true" />
            </a>
          </article>
        ))
      }
    </div>

    <MobileSliderControls
      sliderId="featured-products"
      count={featuredProducts.length}
      label="Featured Products"
    />
  </div>
</section>
