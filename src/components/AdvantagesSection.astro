---
import { ChevronRight } from '@lucide/astro';

interface AdvantageItem {
  id: string;
  title: string;
  description: string;
  href: string;
  barColorClass: string;
}

const advantages: AdvantageItem[] = [
  {
    id: 'sealing-technology',
    title: 'Sealing Technology',
    description:
      'Reliable designs and manufactures mechanical seals and associated products engineered for extreme industrial performance.',
    href: '/products',
    barColorClass: 'bg-[#009FE3]',
  },
  {
    id: 'long-standing-experience',
    title: 'Long Standing Experience',
    description:
      'Our collective knowledge of many years in the sealing industry guarantees dependable solutions for your equipment.',
    href: '/about',
    barColorClass: 'bg-[#FFE600]',
  },
  {
    id: 'international-standards',
    title: 'International Standards',
    description:
      'All critical raw material is compliant with international standards such as API 682, ISO 9001:2015, ATEX, and FDA.',
    href: '/certifications',
    barColorClass: 'bg-[#003B6D]',
  },
  {
    id: 'high-quality-manufacturing',
    title: 'High Quality Manufacturing Processes',
    description:
      'Manufacturing high-quality sealing systems is all down to exceptional precision, CNC machining, and automated quality checks.',
    href: '/about',
    barColorClass: 'bg-[#009FE3]',
  },
  {
    id: 'continuous-training',
    title: 'Continuous Training',
    description:
      'To maintain our position at the forefront of technological innovation, our engineers undergo continuous specialized training.',
    href: '/contact?inquiry=Technical%20Training',
    barColorClass: 'bg-[#FFE600]',
  },
  {
    id: 'global-sales-service',
    title: 'Global Sales & Service',
    description:
      'Our aim at Reliable is to ensure utmost satisfaction of our customers across 50+ countries with prompt technical support.',
    href: '/contact',
    barColorClass: 'bg-[#003B6D]',
  },
  {
    id: 'our-legacy',
    title: 'Our Legacy',
    description:
      'We ensure that we make each of our production processes safe, repeatable, and backed by decades of proven industrial trust.',
    href: '/about',
    barColorClass: 'bg-[#009FE3]',
  },
  {
    id: 'environmental-health-safety',
    title: 'Environmental, Health & Safety',
    description:
      "Reliable's management and employees take active participation in workplace safety, eco-conscious practices, and emission reduction.",
    href: '/certifications',
    barColorClass: 'bg-[#003B6D]',
  },
];
---

<section class="bg-[#F4F6F8] py-[3.5rem] min-[769px]:py-[5rem]">
  <div class="site-container grid grid-cols-1 items-stretch gap-[2.5rem] min-[961px]:grid-cols-[300px_1fr] min-[1201px]:grid-cols-[350px_1fr] min-[1201px]:gap-[4rem]">
    <!-- Left Featured Panel (Adapted to Reliable Navy & Lime Palette) -->
    <div class="flex flex-col rounded-[2px] bg-[#003B6D] p-[1.75rem] text-white shadow-[0_4px_20px_rgba(0,43,73,0.08)] min-[577px]:px-[2rem] min-[577px]:py-[2.5rem]">
      <h2 class="mb-[1.5rem] text-[1.5rem] font-bold uppercase tracking-[0.5px] leading-[1.2] text-white min-[769px]:text-[1.75rem]">
        WHY CHOOSE US
      </h2>
      <p class="mb-[1.25rem] text-[0.95rem] leading-[1.6] text-[#e2e8f0]">
        Adverse environmental conditions, high rotational speed and pressure levels place demanding requirements on sealing technology employed in the process industry.
      </p>
      <p class="mb-[2rem] text-[0.95rem] leading-[1.6] text-[#e2e8f0]">
        Reliable Industries has proven itself with its heavy-duty mechanical seals with innovative and tailor-made sealing solutions guaranteeing longer service life and optimal operational safety.
      </p>
      <div class="mt-auto">
        <a
          href="/about"
          class="inline-flex min-h-[44px] cursor-pointer items-center gap-[6px] rounded-[4px] border-2 border-[#FFE600] bg-[#FFE600] px-[1.5rem] py-[0.65rem] text-[0.95rem] font-semibold text-[#003B6D] transition-all duration-300 hover:border-[#E6D000] hover:bg-[#E6D000]"
        >
          <span>Read More</span>
          <ChevronRight size={16} stroke-width={2.2} aria-hidden="true" />
        </a>
      </div>
    </div>

    <!-- Right 2x4 Capability Grid -->
    <div class="grid grid-cols-1 gap-x-[2.5rem] gap-y-[1.75rem] self-center min-[577px]:grid-cols-2 min-[577px]:gap-y-[2.25rem] min-[1201px]:gap-x-[3rem]">
      {
        advantages.map((item) => (
          <article class="flex flex-col items-start">
            <span
              aria-hidden="true"
              class={`mb-[0.75rem] block h-[6px] w-[28px] rounded-[1px] ${item.barColorClass}`}
            />
            <h3 class="mb-[0.5rem] text-[1.1rem] font-bold leading-[1.3] text-[#003B6D]">
              {item.title}
            </h3>
            <p class="mb-[0.75rem] text-[0.95rem] leading-[1.55] text-[#334155]">
              {item.description}
            </p>
            <a
              href={item.href}
              class="inline-flex items-center gap-[3px] py-1 text-[0.9rem] font-semibold text-[#009FE3] transition-colors duration-300 hover:text-[#003B6D] min-[961px]:py-0"
            >
              <span>Details</span>
              <ChevronRight size={15} stroke-width={2.2} aria-hidden="true" />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
