---
import { FileText, Phone } from '@lucide/astro';
import { SITE_CONFIG } from '@/config/site';

const primaryPhoneTel = `tel:${SITE_CONFIG.businessDetails.phones[0].replace(/[^+\d]/g, '')}`;
---

<aside
  aria-label="Quick Contact Actions"
  class="fixed right-[14px] bottom-[16px] z-[90] flex flex-col items-end gap-[8px] min-[769px]:right-[22px] min-[769px]:bottom-[22px]"
>
  <!-- 1. WhatsApp (Official WhatsApp Mark) -->
  <a
    href={SITE_CONFIG.businessDetails.whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="WhatsApp Reliable Industries"
    title="WhatsApp Us"
    class="group flex items-center gap-[8px]"
  >
    <span class="pointer-events-none hidden rounded-[2px] border border-[#e2e8f0] bg-[#003B6D] px-[10px] py-[4px] text-[0.75rem] font-semibold whitespace-nowrap text-white opacity-0 shadow-[0_4px_15px_rgba(0,0,0,0.12)] transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 min-[769px]:block">
      WhatsApp Us
    </span>
    <span class="flex h-[44px] w-[44px] items-center justify-center rounded-full border border-white/20 bg-[#25D366] text-white shadow-[0_4px_15px_rgba(0,43,73,0.18)] transition-colors duration-200 group-hover:bg-[#1EBE5D]">
      <svg
        viewBox="0 0 24 24"
        width="21"
        height="21"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12.04 2C6.52 2 2.04 6.48 2.04 12c0 1.77.46 3.49 1.34 5.01L2 22l5.12-1.34A9.96 9.96 0 0 0 12.04 22c5.52 0 10-4.48 10-10S17.56 2 12.04 2Zm0 18.22a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.04.8.81-2.96-.2-.31a8.21 8.21 0 1 1 6.91 3.8Zm4.51-6.15c-.25-.12-1.46-.72-1.69-.8-.22-.08-.39-.12-.55.12-.17.25-.64.8-.78.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.99-1.22-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.17 0-.43.06-.66.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.19 3.7.59.25 1.04.4 1.4.51.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.07.14-1.17-.06-.1-.23-.16-.48-.29Z" />
      </svg>
    </span>
  </a>

  <!-- 2. Call Us -->
  <a
    href={primaryPhoneTel}
    aria-label="Call Reliable Industries"
    title="Call Us"
    class="group flex items-center gap-[8px]"
  >
    <span class="pointer-events-none hidden rounded-[2px] border border-[#e2e8f0] bg-[#003B6D] px-[10px] py-[4px] text-[0.75rem] font-semibold whitespace-nowrap text-white opacity-0 shadow-[0_4px_15px_rgba(0,0,0,0.12)] transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 min-[769px]:block">
      Call Us
    </span>
    <span class="flex h-[44px] w-[44px] items-center justify-center rounded-full border border-white/20 bg-[#003B6D] text-white shadow-[0_4px_15px_rgba(0,43,73,0.18)] transition-colors duration-200 group-hover:bg-[#002038]">
      <Phone size={19} stroke-width={2} aria-hidden="true" />
    </span>
  </a>

  <!-- 3. Get Quote -->
  <a
    href="/contact?inquiry=Quote%20Request"
    aria-label="Get a Quote"
    title="Get Quote"
    class="group flex items-center gap-[8px]"
  >
    <span class="pointer-events-none hidden rounded-[2px] border border-[#e2e8f0] bg-[#003B6D] px-[10px] py-[4px] text-[0.75rem] font-semibold whitespace-nowrap text-white opacity-0 shadow-[0_4px_15px_rgba(0,0,0,0.12)] transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 min-[769px]:block">
      Get Quote
    </span>
    <span class="flex h-[44px] w-[44px] items-center justify-center rounded-full border border-[#003B6D]/20 bg-[#FFE600] text-[#003B6D] shadow-[0_4px_15px_rgba(0,43,73,0.18)] transition-colors duration-200 group-hover:bg-[#E6D000]">
      <FileText size={19} stroke-width={2} aria-hidden="true" />
    </span>
  </a>
</aside>
