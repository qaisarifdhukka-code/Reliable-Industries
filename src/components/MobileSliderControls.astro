---
import { ChevronLeft, ChevronRight } from '@lucide/astro';

interface Props {
  sliderId: string;
  count: number;
  label: string;
}

const { sliderId, count, label } = Astro.props;
const indices = Array.from({ length: count }, (_, idx) => idx);
---

<div
  class="mt-[1.25rem] flex items-center justify-between gap-4 min-[769px]:hidden"
  data-mobile-slider-controls={sliderId}
  role="region"
  aria-label={`${label} slider navigation`}
>
  <div class="flex items-center gap-[6px]" role="tablist" aria-label={`${label} slides`}>
    {
      indices.map((idx) => (
        <button
          type="button"
          data-slider-dot={idx}
          aria-label={`Show ${label} slide ${idx + 1}`}
          aria-selected={idx === 0 ? 'true' : 'false'}
          class:list={[
            'h-[8px] cursor-pointer rounded-[2px] border-none transition-all duration-200',
            idx === 0 ? 'w-[22px] bg-[#009FE3]' : 'w-[8px] bg-[#cbd5e1]',
          ]}
        />
      ))
    }
  </div>

  <div class="flex items-center gap-[8px]">
    <button
      type="button"
      data-slider-prev
      aria-label={`Previous ${label}`}
      class="flex h-[38px] w-[38px] cursor-pointer items-center justify-center rounded-none border border-[#003B6D] bg-white text-[#003B6D] transition-colors duration-200 hover:bg-[#003B6D] hover:text-white disabled:cursor-not-allowed disabled:opacity-40"
    >
      <ChevronLeft size={18} stroke-width={2.2} aria-hidden="true" />
    </button>
    <button
      type="button"
      data-slider-next
      aria-label={`Next ${label}`}
      class="flex h-[38px] w-[38px] cursor-pointer items-center justify-center rounded-none border border-[#003B6D] bg-[#003B6D] text-white transition-colors duration-200 hover:border-[#009FE3] hover:bg-[#009FE3] disabled:cursor-not-allowed disabled:opacity-40"
    >
      <ChevronRight size={18} stroke-width={2.2} aria-hidden="true" />
    </button>
  </div>
</div>

<script>
  const controlGroups = document.querySelectorAll<HTMLElement>(
    '[data-mobile-slider-controls]'
  );

  controlGroups.forEach((controls) => {
    const id = controls.dataset.mobileSliderControls;
    if (!id) return;

    const track = document.querySelector<HTMLElement>(
      `[data-mobile-slider-track="${id}"]`
    );
    if (!track) return;

    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(
      controls.querySelectorAll<HTMLButtonElement>('[data-slider-dot]')
    );
    const prevBtn = controls.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const nextBtn = controls.querySelector<HTMLButtonElement>('[data-slider-next]');

    let activeIndex = 0;

    const updateUI = (index: number) => {
      activeIndex = Math.max(0, Math.min(index, slides.length - 1));
      dots.forEach((dot, i) => {
        const isCurrent = i === activeIndex;
        dot.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        dot.classList.toggle('w-[22px]', isCurrent);
        dot.classList.toggle('bg-[#009FE3]', isCurrent);
        dot.classList.toggle('w-[8px]', !isCurrent);
        dot.classList.toggle('bg-[#cbd5e1]', !isCurrent);
      });
      if (prevBtn) prevBtn.disabled = activeIndex === 0;
      if (nextBtn) nextBtn.disabled = activeIndex >= slides.length - 1;
    };

    const scrollToSlide = (index: number) => {
      const clamped = Math.max(0, Math.min(index, slides.length - 1));
      const target = slides[clamped];
      if (!target) return;
      const trackRect = track.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      track.scrollTo({
        left: track.scrollLeft + (targetRect.left - trackRect.left),
        behavior: 'smooth',
      });
      updateUI(clamped);
    };

    prevBtn?.addEventListener('click', () => scrollToSlide(activeIndex - 1));
    nextBtn?.addEventListener('click', () => scrollToSlide(activeIndex + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => scrollToSlide(i)));

    let scrollRaf = 0;
    track.addEventListener(
      'scroll',
      () => {
        if (scrollRaf) cancelAnimationFrame(scrollRaf);
        scrollRaf = requestAnimationFrame(() => {
          const trackLeft = track.getBoundingClientRect().left;
          let closestIdx = 0;
          let closestDist = Infinity;
          slides.forEach((slide, i) => {
            const dist = Math.abs(slide.getBoundingClientRect().left - trackLeft);
            if (dist < closestDist) {
              closestDist = dist;
              closestIdx = i;
            }
          });
          updateUI(closestIdx);
        });
      },
      { passive: true }
    );

    updateUI(0);
  });
</script>
